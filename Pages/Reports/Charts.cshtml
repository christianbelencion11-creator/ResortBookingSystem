@page
@model ResortBookingSystem.Pages.Reports.ChartsModel
@{ ViewData["Title"] = "Charts & Analytics"; }

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-header">
            <div>
                <div class="stat-value" style="color: var(--success);">₱@Model.MonthlyRevenue.ToString("N0")</div>
                <div class="stat-label">This Month Revenue</div>
            </div>
            <div class="stat-icon green"><i class="bi bi-cash-stack"></i></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div>
                <div class="stat-value" style="color: var(--info);">@Model.TotalBookings</div>
                <div class="stat-label">Total Bookings</div>
            </div>
            <div class="stat-icon blue"><i class="bi bi-calendar-check"></i></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div>
                <div class="stat-value" style="color: var(--warning);">@Model.AvgOccupancy%</div>
                <div class="stat-label">Avg Occupancy</div>
            </div>
            <div class="stat-icon orange"><i class="bi bi-pie-chart"></i></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div>
                <div class="stat-value" style="color: #9b59b6;">@(Model.TopActivityName ?? "-")</div>
                <div class="stat-label">Top Activity</div>
            </div>
            <div class="stat-icon purple"><i class="bi bi-trophy"></i></div>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
    <div class="card">
        <div class="card-header">
            <h5><i class="bi bi-bar-chart" style="color: var(--primary);"></i> Monthly Revenue</h5>
            <span class="badge badge-success">Last 6 months</span>
        </div>
        <div class="card-body" style="padding: 16px 20px;">
            <canvas id="revenueChart" height="280"></canvas>
        </div>
    </div>
    <div class="card">
        <div class="card-header">
            <h5><i class="bi bi-pie-chart" style="color: var(--info);"></i> Bookings by Status</h5>
        </div>
        <div class="card-body" style="padding: 16px 20px; display: flex; align-items: center; justify-content: center;">
            <canvas id="statusChart" height="280" style="max-height: 280px;"></canvas>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
    <div class="card">
        <div class="card-header">
            <h5><i class="bi bi-compass" style="color: var(--success);"></i> Top Activities</h5>
        </div>
        <div class="card-body" style="padding: 16px 20px;">
            <canvas id="activityChart" height="280"></canvas>
        </div>
    </div>
    <div class="card">
        <div class="card-header">
            <h5><i class="bi bi-door-open" style="color: var(--warning);"></i> Room Status Distribution</h5>
        </div>
        <div class="card-body" style="padding: 16px 20px; display: flex; align-items: center; justify-content: center;">
            <canvas id="roomChart" height="280" style="max-height: 280px;"></canvas>
        </div>
    </div>
</div>

<div class="card" style="margin-top: 20px;">
    <div class="card-header">
        <h5><i class="bi bi-credit-card" style="color: var(--info);"></i> Payment Methods Breakdown</h5>
    </div>
    <div class="card-body" style="padding: 16px 20px;">
        <canvas id="paymentChart" height="200"></canvas>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    var colors = ['#43b97f', '#3498db', '#f5a623', '#e74c3c', '#9b59b6', '#1abc9c', '#e67e22', '#2c3e50'];
    var chartDefaults = {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
            x: { grid: { display: false }, ticks: { font: { size: 11 } } },
            y: { grid: { color: '#f0f2f7' }, ticks: { font: { size: 11 } }, beginAtZero: true }
        }
    };

    new Chart(document.getElementById('revenueChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueLabels)),
            datasets: [{
                label: 'Revenue (₱)',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueData)),
                backgroundColor: 'rgba(67,185,127,0.8)',
                borderColor: '#43b97f',
                borderWidth: 1,
                borderRadius: 8,
                barThickness: 40
            }]
        },
        options: chartDefaults
    });

    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusLabels)),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusData)),
                backgroundColor: ['#f5a623', '#43b97f', '#3498db', '#95a5a6', '#e74c3c'],
                borderWidth: 0,
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { padding: 16, usePointStyle: true, font: { size: 12 } } }
            },
            cutout: '60%'
        }
    });

    new Chart(document.getElementById('activityChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityLabels)),
            datasets: [{
                label: 'Bookings',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityData)),
                backgroundColor: colors.slice(0, @Model.ActivityLabels.Count),
                borderRadius: 6,
                barThickness: 28
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: '#f0f2f7' }, ticks: { font: { size: 11 } }, beginAtZero: true },
                y: { grid: { display: false }, ticks: { font: { size: 12 } } }
            }
        }
    });

    new Chart(document.getElementById('roomChart'), {
        type: 'pie',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RoomStatusLabels)),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RoomStatusData)),
                backgroundColor: ['#43b97f', '#3498db', '#f5a623', '#95a5a6'],
                borderWidth: 0,
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { padding: 16, usePointStyle: true, font: { size: 12 } } }
            }
        }
    });

    new Chart(document.getElementById('paymentChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PaymentLabels)),
            datasets: [{
                label: 'Total (₱)',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PaymentData)),
                backgroundColor: colors.slice(0, @Model.PaymentLabels.Count),
                borderRadius: 8,
                barThickness: 50
            }]
        },
        options: chartDefaults
    });
</script>
}

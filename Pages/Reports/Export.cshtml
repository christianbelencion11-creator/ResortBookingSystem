@page
@model ResortBookingSystem.Pages.Reports.ExportModel
@{ ViewData["Title"] = "Export Data"; }

<div style="max-width:600px;">
    <div class="card">
        <div class="card-header">
            <h5><i class="bi bi-download"></i> Export Data to CSV</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Data to Export</label>
                    <select asp-for="ExportType" class="form-select">
                        <option value="reservations">Reservations</option>
                        <option value="payments">Payments</option>
                        <option value="guests">Guests</option>
                        <option value="rooms">Rooms</option>
                    </select>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
                    <div>
                        <label class="form-label">Date From</label>
                        <input asp-for="DateFrom" type="date" class="form-control" />
                    </div>
                    <div>
                        <label class="form-label">Date To</label>
                        <input asp-for="DateTo" type="date" class="form-control" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-download"></i> Export CSV</button>
                <a asp-page="Index" class="btn btn-outline" style="margin-left:8px;">Back to Reports</a>
            </form>
        </div>
    </div>
</div>

@page
@model ResortBookingSystem.Pages.Notifications.IndexModel
@{ ViewData["Title"] = "Notifications"; }

<div class="filter-bar">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search notifications..." id="notifSearch" oninput="filterNotifs(this.value)" />
    </div>
    <div class="filter-tabs">
        <button class="filter-tab active" onclick="filterByType(this, '')">All</button>
        <button class="filter-tab" onclick="filterByType(this, 'reservation')">Reservations</button>
        <button class="filter-tab" onclick="filterByType(this, 'payment')">Payments</button>
        <button class="filter-tab" onclick="filterByType(this, 'checkin')">Check-Ins</button>
        <button class="filter-tab" onclick="filterByType(this, 'checkout')">Check-Outs</button>
        <button class="filter-tab" onclick="filterByType(this, 'room')">Rooms</button>
        <button class="filter-tab" onclick="filterByType(this, 'alert')">Alerts</button>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5><i class="bi bi-bell"></i> All Notifications <span class="badge badge-info" style="font-size:11px; vertical-align:middle; margin-left:6px;">@Model.Notifications.Count</span></h5>
    </div>
    <div id="notifContainer">
        @if (Model.Notifications.Any())
        {
            @foreach (var n in Model.Notifications)
            {
                <div class="notif-item" data-type="@n.Type">
                    <div class="notif-icon @n.IconColor"><i class="bi @n.Icon"></i></div>
                    <div style="flex: 1;">
                        <div class="notif-text">@n.Text</div>
                        <div class="notif-time">@n.TimeAgo</div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-bell-slash"></i>
                <p>No notifications yet</p>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function filterNotifs(q) {
        document.querySelectorAll('#notifContainer .notif-item').forEach(function(el) {
            el.style.display = el.textContent.toLowerCase().includes(q.toLowerCase()) ? '' : 'none';
        });
    }
    function filterByType(btn, type) {
        document.querySelectorAll('.filter-tab').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        document.querySelectorAll('#notifContainer .notif-item').forEach(function(el) {
            el.style.display = (!type || el.dataset.type === type) ? '' : 'none';
        });
    }
</script>
}

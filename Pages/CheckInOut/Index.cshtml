@page
@model ResortBookingSystem.Pages.CheckInOut.IndexModel
@{ ViewData["Title"] = "Check-In / Check-Out"; }

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-header">
            <div>
                <div class="stat-value">@Model.TodayCheckIns.Count</div>
                <div class="stat-label">Today's Check-Ins</div>
            </div>
            <div class="stat-icon green"><i class="bi bi-box-arrow-in-right"></i></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div>
                <div class="stat-value">@Model.TodayCheckOuts.Count</div>
                <div class="stat-label">Today's Check-Outs</div>
            </div>
            <div class="stat-icon blue"><i class="bi bi-box-arrow-right"></i></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div>
                <div class="stat-value">@Model.PendingReservations.Count</div>
                <div class="stat-label">Pending Confirmations</div>
            </div>
            <div class="stat-icon orange"><i class="bi bi-clock-history"></i></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div>
                <div class="stat-value">@Model.ActiveStays.Count</div>
                <div class="stat-label">Active Stays</div>
            </div>
            <div class="stat-icon purple"><i class="bi bi-house-door"></i></div>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;" class="checkinout-grid">
    <!-- Check-Ins -->
    <div class="card">
        <div class="card-header"><h5><i class="bi bi-box-arrow-in-right"></i> Today's Check-Ins</h5></div>
        <div class="card-body">
            @if (Model.TodayCheckIns.Any())
            {
                @foreach (var r in Model.TodayCheckIns)
                {
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 8px;">
                        <div>
                            <strong>#@r.ReservationId</strong> - @(r.Guest?.FullName ?? r.User?.FullName ?? "N/A")
                            <div style="font-size: 12px; color: var(--text-muted);">@r.NumberOfNights night(s) | ₱@r.TotalAmount.ToString("N2")</div>
                        </div>
                        <form method="post" asp-page-handler="CheckIn" asp-route-id="@r.ReservationId">
                            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg"></i> Check In</button>
                        </form>
                    </div>
                }
            }
            else
            {
                <div class="empty-state"><i class="bi bi-check-circle"></i><p>No check-ins for today</p></div>
            }
        </div>
    </div>

    <!-- Check-Outs -->
    <div class="card">
        <div class="card-header"><h5><i class="bi bi-box-arrow-right"></i> Today's Check-Outs</h5></div>
        <div class="card-body">
            @if (Model.TodayCheckOuts.Any())
            {
                @foreach (var r in Model.TodayCheckOuts)
                {
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 8px;">
                        <div>
                            <strong>#@r.ReservationId</strong> - @(r.Guest?.FullName ?? r.User?.FullName ?? "N/A")
                            <div style="font-size: 12px; color: var(--text-muted);">Balance: ₱@r.Balance.ToString("N2")</div>
                        </div>
                        <form method="post" asp-page-handler="CheckOut" asp-route-id="@r.ReservationId">
                            <button type="submit" class="btn btn-sm btn-info"><i class="bi bi-box-arrow-right"></i> Check Out</button>
                        </form>
                    </div>
                }
            }
            else
            {
                <div class="empty-state"><i class="bi bi-check-circle"></i><p>No check-outs for today</p></div>
            }
        </div>
    </div>

    <!-- Pending -->
    <div class="card">
        <div class="card-header"><h5><i class="bi bi-clock-history"></i> Pending Confirmations</h5></div>
        <div class="card-body">
            @if (Model.PendingReservations.Any())
            {
                @foreach (var r in Model.PendingReservations)
                {
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 8px;">
                        <div>
                            <strong>#@r.ReservationId</strong> - @(r.Guest?.FullName ?? r.User?.FullName ?? "N/A")
                            <div style="font-size: 12px; color: var(--text-muted);">Check-in: @r.CheckInDate.ToString("MMM dd")</div>
                        </div>
                        <form method="post" asp-page-handler="Confirm" asp-route-id="@r.ReservationId">
                            <button type="submit" class="btn btn-sm btn-warning"><i class="bi bi-check-circle"></i> Confirm</button>
                        </form>
                    </div>
                }
            }
            else
            {
                <div class="empty-state"><i class="bi bi-check-circle"></i><p>No pending reservations</p></div>
            }
        </div>
    </div>

    <!-- Active Stays -->
    <div class="card">
        <div class="card-header"><h5><i class="bi bi-house-door"></i> Active Stays</h5></div>
        <div class="card-body">
            @if (Model.ActiveStays.Any())
            {
                @foreach (var r in Model.ActiveStays)
                {
                    <div style="padding: 12px; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 8px;">
                        <strong>#@r.ReservationId</strong> - @(r.Guest?.FullName ?? r.User?.FullName ?? "N/A")
                        <div style="font-size: 12px; color: var(--text-muted);">Since @r.CheckInDate.ToString("MMM dd") | Balance: ₱@r.Balance.ToString("N2")</div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state"><i class="bi bi-check-circle"></i><p>No active stays</p></div>
            }
        </div>
    </div>
</div>

@page
@model ResortBookingSystem.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="card p-5 text-center my-5" style="max-width: 650px; margin: 0 auto; border-radius: 16px;">
    <div style="font-size: 4rem; color: var(--danger); margin-bottom: 1rem;">
        <i class="bi bi-exclamation-triangle-fill"></i>
    </div>
    <h2 class="mb-3">Oops! Something went wrong</h2>
    <p class="text-muted mb-4">An unexpected error occurred while processing your request. Please try again or return to the dashboard.</p>
    
    @if (Model.ShowRequestId)
    {
        <div class="alert alert-light border py-2 px-3 mb-4 text-start font-monospace small">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </div>
    }

    <div>
        <a asp-page="/Index" class="btn btn-primary px-4 py-2">
            <i class="bi bi-house-door me-1"></i> Back to Dashboard
        </a>
    </div>
</div>

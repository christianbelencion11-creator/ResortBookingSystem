@page
@model ResortBookingSystem.Pages.Expenses.IndexModel
@{ ViewData["Title"] = "Expenses"; }

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-header">
            <div>
                <div class="stat-value">₱@Model.TotalExpenses.ToString("N0")</div>
                <div class="stat-label">Total Expenses This Month</div>
            </div>
            <div class="stat-icon red"><i class="bi bi-arrow-down-circle"></i></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div>
                <div class="stat-value">@Model.ExpenseCount</div>
                <div class="stat-label">Transactions</div>
            </div>
            <div class="stat-icon blue"><i class="bi bi-receipt"></i></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-header">
            <div>
                <div class="stat-value">₱@Model.NetProfit.ToString("N0")</div>
                <div class="stat-label">Net Profit (Revenue - Expenses)</div>
            </div>
            <div class="stat-icon green"><i class="bi bi-graph-up-arrow"></i></div>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px;">
    <div class="card">
        <div class="card-header">
            <h5>Expense List</h5>
        </div>
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr><th>Date</th><th>Category</th><th>Description</th><th>Amount</th><th>Recorded By</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Expenses)
                    {
                        <tr>
                            <td>@e.Date.ToString("MMM dd, yyyy")</td>
                            <td><span class="badge badge-info">@e.Category</span></td>
                            <td>@e.Description</td>
                            <td style="color: var(--danger); font-weight: 600;">₱@e.Amount.ToString("N2")</td>
                            <td>@e.RecordedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5>Record Expense</h5></div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select asp-for="Input.Category" class="form-select">
                        <option value="Maintenance">Maintenance</option>
                        <option value="Utilities">Utilities</option>
                        <option value="Supplies">Supplies</option>
                        <option value="Staff">Staff Wages</option>
                        <option value="Food">Food & Beverage</option>
                        <option value="Transport">Transportation</option>
                        <option value="Marketing">Marketing</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <input asp-for="Input.Description" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Amount (₱)</label>
                    <input asp-for="Input.Amount" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Date</label>
                    <input asp-for="Input.Date" type="date" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;"><i class="bi bi-plus-lg"></i> Add Expense</button>
            </form>
        </div>
    </div>
</div>

@page
@model ResortBookingSystem.Pages.Rooms.IndexModel
@{ ViewData["Title"] = "Rooms & Cottages"; }

<div class="filter-bar">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search rooms..." id="roomSearch" oninput="filterRooms(this.value)" />
    </div>
    <div class="filter-tabs">
        <button class="filter-tab active" onclick="filterByStatus(this, '')">All</button>
        <button class="filter-tab" onclick="filterByStatus(this, 'Available')">Available</button>
        <button class="filter-tab" onclick="filterByStatus(this, 'Occupied')">Occupied</button>
        <button class="filter-tab" onclick="filterByStatus(this, 'UnderMaintenance')">Maintenance</button>
    </div>
    <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Room</a>
</div>

<div class="card">
    <div class="table-wrapper">
        <table class="table" id="roomsTable">
            <thead>
                <tr>
                    <th>Room #</th>
                    <th>Type</th>
                    <th>Floor</th>
                    <th>Price/Night</th>
                    <th>Max Guests</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var room in Model.Rooms)
                {
                    <tr data-status="@room.Status" data-id="@room.RoomId">
                        <td><strong>@room.RoomNumber</strong></td>
                        <td>@room.RoomType.TypeName</td>
                        <td>@(room.Floor?.ToString() ?? "-")</td>
                        <td><strong>₱@room.RoomType.BasePrice.ToString("N0")</strong></td>
                        <td>@room.RoomType.MaxOccupancy pax</td>
                        <td><span class="status-badge status-@room.Status"><span class="status-dot"></span> @room.Status</span></td>
                        <td>
                            <div class="table-actions">
                                <a asp-page="Edit" asp-route-id="@room.RoomId" class="btn-icon" title="Edit"><i class="bi bi-pencil"></i></a>
                                <button class="btn-icon danger" title="Delete" onclick="confirmDelete(@room.RoomId, '@room.RoomNumber')"><i class="bi bi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Room Modal -->
<div class="modal fade" id="deleteRoomModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <input type="hidden" id="deleteRoomId" />
            <div class="modal-header" style="background: rgba(231,76,60,0.1); border-bottom: 1px solid rgba(231,76,60,0.2);">
                <h5 class="modal-title" style="color: var(--danger);"><i class="bi bi-trash"></i> Delete Room</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="deleteRoomNumber"></strong>?</p>
                <p class="text-muted" style="font-size: 13px;">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="doDeleteRoom()"><i class="bi bi-trash"></i> Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function filterRooms(q) {
        document.querySelectorAll('#roomsTable tbody tr').forEach(r => {
            r.style.display = r.textContent.toLowerCase().includes(q.toLowerCase()) ? '' : 'none';
        });
    }
    function filterByStatus(btn, status) {
        document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('#roomsTable tbody tr').forEach(r => {
            r.style.display = (!status || r.dataset.status === status) ? '' : 'none';
        });
    }
    function confirmDelete(id, number) {
        document.getElementById('deleteRoomId').value = id;
        document.getElementById('deleteRoomNumber').textContent = 'Room #' + number;
        new bootstrap.Modal(document.getElementById('deleteRoomModal')).show();
    }
    function doDeleteRoom() {
        var id = document.getElementById('deleteRoomId').value;
        fetch('/Api/CrudApi?handler=DeleteRoom', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + id
        }).then(function(r) { return r.json(); }).then(function(d) {
            bootstrap.Modal.getInstance(document.getElementById('deleteRoomModal')).hide();
            if (d.success) {
                var row = document.querySelector('#roomsTable tbody tr[data-id="' + id + '"]');
                if (row) {
                    row.style.transition = 'opacity 0.3s';
                    row.style.opacity = '0';
                    setTimeout(function() { row.remove(); }, 300);
                }
                showToast(d.message, 'success');
            }
        });
    }
</script>
}

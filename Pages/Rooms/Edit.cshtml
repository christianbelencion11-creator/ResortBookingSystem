@page "{id:int}"
@model ResortBookingSystem.Pages.Rooms.EditModel
@{ ViewData["Title"] = "Edit Room " + Model.Room.RoomNumber; }

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card" style="border:none; border-radius:16px; box-shadow:0 2px 12px rgba(0,0,0,0.06); overflow:hidden;">
            <div style="background:linear-gradient(135deg,#4a90d9,#357abd); padding:28px 32px; color:#fff;">
                <div style="display:flex; align-items:center; gap:12px;">
                    <div style="width:44px; height:44px; background:rgba(255,255,255,0.2); border-radius:12px; display:flex; align-items:center; justify-content:center;">
                        <i class="bi bi-door-open" style="font-size:20px;"></i>
                    </div>
                    <div>
                        <h5 style="margin:0; font-weight:700;">Edit Room @Model.Room.RoomNumber</h5>
                        <p style="margin:0; opacity:0.85; font-size:13px;">Update room details</p>
                    </div>
                </div>
            </div>
            <div class="card-body" style="padding:28px 32px;">
                <form method="post">
                    <input type="hidden" asp-for="Room.RoomId" />
                    <input type="hidden" asp-for="Room.CreatedAt" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" style="font-weight:600; font-size:13px; color:var(--text-muted);">Room Number *</label>
                            <input asp-for="Room.RoomNumber" class="form-control" style="border-radius:10px; padding:10px 14px; border:1px solid var(--border);" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" style="font-weight:600; font-size:13px; color:var(--text-muted);">Floor</label>
                            <input asp-for="Room.Floor" type="number" class="form-control" style="border-radius:10px; padding:10px 14px; border:1px solid var(--border);" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600; font-size:13px; color:var(--text-muted);">Room Type *</label>
                        <select asp-for="Room.RoomTypeId" asp-items="Model.RoomTypeList" class="form-select" style="border-radius:10px; padding:10px 14px; border:1px solid var(--border);"></select>
                    </div>

                    <div style="border-top:1px solid var(--border); margin:20px 0;"></div>

                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600; font-size:13px; color:var(--text-muted);">Status</label>
                        <select asp-for="Room.Status" asp-items="Html.GetEnumSelectList<RoomStatus>()" class="form-select" style="border-radius:10px; padding:10px 14px; border:1px solid var(--border);"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600; font-size:13px; color:var(--text-muted);">Description</label>
                        <textarea asp-for="Room.Description" class="form-control" rows="3" style="border-radius:10px; padding:10px 14px; border:1px solid var(--border);"></textarea>
                    </div>

                    <div style="border-top:1px solid var(--border); margin:20px 0;"></div>

                    <div style="display:flex; gap:12px;">
                        <button type="submit" class="btn btn-primary" style="flex:1; padding:10px; border-radius:10px; font-weight:600; font-size:14px;"><i class="bi bi-check-lg"></i> Update Room</button>
                        <a asp-page="Index" class="btn" style="flex:0.5; padding:10px; border-radius:10px; font-weight:600; font-size:14px; background:var(--bg-secondary, #f0f0f0); color:var(--text); border:none;">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

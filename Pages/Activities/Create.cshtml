@page
@model ResortBookingSystem.Pages.Activities.CreateModel
@{ ViewData["Title"] = "Add Activity"; }

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card" style="border:none; border-radius:16px; box-shadow:0 2px 12px rgba(0,0,0,0.06); overflow:hidden;">
            <div style="background:linear-gradient(135deg,#43b97f,#2d9c6f); padding:28px 32px; color:#fff;">
                <div style="display:flex; align-items:center; gap:12px;">
                    <div style="width:44px; height:44px; background:rgba(255,255,255,0.2); border-radius:12px; display:flex; align-items:center; justify-content:center;">
                        <i class="bi bi-plus-circle" style="font-size:20px;"></i>
                    </div>
                    <div>
                        <h5 style="margin:0; font-weight:700;">Add New Activity</h5>
                        <p style="margin:0; opacity:0.85; font-size:13px;">Create a new activity for guests</p>
                    </div>
                </div>
            </div>
            <div class="card-body" style="padding:28px 32px;">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600; font-size:13px; color:var(--text-muted);">Activity Name *</label>
                        <input asp-for="Activity.ActivityName" class="form-control" placeholder="e.g., Kayaking Adventure" style="border-radius:10px; padding:10px 14px; border:1px solid var(--border);" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600; font-size:13px; color:var(--text-muted);">Description</label>
                        <textarea asp-for="Activity.Description" class="form-control" rows="3" placeholder="Describe the activity..." style="border-radius:10px; padding:10px 14px; border:1px solid var(--border);"></textarea>
                    </div>

                    <div style="border-top:1px solid var(--border); margin:20px 0;"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" style="font-weight:600; font-size:13px; color:var(--text-muted);">Price per Hour (₱)</label>
                            <input asp-for="Activity.PricePerHour" type="number" step="0.01" class="form-control" placeholder="0.00" style="border-radius:10px; padding:10px 14px; border:1px solid var(--border);" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" style="font-weight:600; font-size:13px; color:var(--text-muted);">Price per Day (₱)</label>
                            <input asp-for="Activity.PricePerDay" type="number" step="0.01" class="form-control" placeholder="0.00" style="border-radius:10px; padding:10px 14px; border:1px solid var(--border);" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-weight:600; font-size:13px; color:var(--text-muted);">Max Participants</label>
                        <input asp-for="Activity.MaxParticipants" type="number" class="form-control" placeholder="e.g., 10" style="border-radius:10px; padding:10px 14px; border:1px solid var(--border);" />
                    </div>

                    <div style="border-top:1px solid var(--border); margin:20px 0;"></div>

                    <div style="display:flex; gap:12px;">
                        <button type="submit" class="btn btn-success" style="flex:1; padding:10px; border-radius:10px; font-weight:600; font-size:14px;"><i class="bi bi-check-lg"></i> Save Activity</button>
                        <a asp-page="Index" class="btn" style="flex:0.5; padding:10px; border-radius:10px; font-weight:600; font-size:14px; background:var(--bg-secondary, #f0f0f0); color:var(--text); border:none;">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

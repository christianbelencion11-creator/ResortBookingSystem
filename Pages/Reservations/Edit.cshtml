@page "{id:int}"
@model ResortBookingSystem.Pages.Reservations.EditModel
@{
    ViewData["Title"] = "Edit Reservation #" + Model.Reservation.ReservationId;
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a asp-page="Index" class="btn-icon" title="Back"><i class="bi bi-arrow-left"></i></a>
    <h5 style="margin:0;">Edit Reservation #@Model.Reservation.ReservationId</h5>
    <span class="status-badge status-@Model.Reservation.Status"><span class="status-dot"></span> @Model.Reservation.Status</span>
</div>

<form method="post" id="editForm">
    <input type="hidden" asp-for="Reservation.ReservationId" />
    <input type="hidden" name="itemsJson" id="itemsJson" />
    <input type="hidden" name="discountCode" id="discountCodeHidden" />

    <div style="display:grid; grid-template-columns:2fr 1fr; gap:20px;">
        <!-- Left: Booking Details -->
        <div>
            <!-- Guest & Dates -->
            <div class="card" style="margin-bottom:16px;">
                <div class="card-header"><h5><i class="bi bi-person"></i> Guest & Dates</h5></div>
                <div class="card-body">
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                        <div>
                            <label class="form-label">Guest</label>
                            <select asp-for="Reservation.GuestId" class="form-select">
                                <option value="0">-- Select Guest --</option>
                                @foreach (var g in Model.Guests)
                                {
                                    <option value="@g.GuestId">@g.FullName (@g.PhoneNumber)</option>
                                }
                            </select>
                        </div>
                        <div></div>
                        <div>
                            <label class="form-label">Check-In Date</label>
                            <input asp-for="Reservation.CheckInDate" type="date" class="form-control" />
                        </div>
                        <div>
                            <label class="form-label">Check-Out Date</label>
                            <input asp-for="Reservation.CheckOutDate" type="date" class="form-control" />
                        </div>
                    </div>
                    <div style="margin-top:12px;">
                        <label class="form-label">Special Requests</label>
                        <textarea asp-for="Reservation.SpecialRequests" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>

            <!-- Items -->
            <div class="card" style="margin-bottom:16px;">
                <div class="card-header">
                    <h5><i class="bi bi-cart"></i> Booking Items</h5>
                </div>
                <div class="card-body">
                    <!-- Add Room -->
                    <div style="display:flex; gap:8px; margin-bottom:12px;">
                        <select id="addRoomSelect" class="form-select" style="flex:2;">
                            <option value="">-- Add Room --</option>
                            @foreach (var r in Model.AvailableRooms)
                            {
                                <option value="@r.RoomId" data-price="@r.BasePrice" data-name="@r.RoomNumber (@r.TypeName)">@r.RoomNumber - @r.TypeName (₱@r.BasePrice/night)</option>
                            }
                        </select>
                        <button type="button" class="btn btn-primary btn-sm" onclick="addRoom()"><i class="bi bi-plus"></i> Add</button>
                    </div>

                    <!-- Add Activity -->
                    <div style="display:flex; gap:8px; margin-bottom:16px;">
                        <select id="addActivitySelect" class="form-select" style="flex:2;">
                            <option value="">-- Add Activity --</option>
                            @foreach (var a in Model.AvailableActivities)
                            {
                                <option value="@a.ActivityId" data-price="@a.Price" data-name="@a.ActivityName">@a.ActivityName (₱@a.Price)</option>
                            }
                        </select>
                        <button type="button" class="btn btn-info btn-sm" onclick="addActivity()"><i class="bi bi-plus"></i> Add</button>
                    </div>

                    <!-- Items Table -->
                    <table class="table" id="itemsTable">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Type</th>
                                <th>Price</th>
                                <th>Qty</th>
                                <th>Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right: Summary -->
        <div>
            <div class="card" style="position:sticky; top:20px;">
                <div class="card-header"><h5><i class="bi bi-calculator"></i> Summary</h5></div>
                <div class="card-body">
                    <div style="margin-bottom:12px;">
                        <label class="form-label">Apply Discount Code</label>
                        <div style="display:flex; gap:8px;">
                            <input type="text" id="discountInput" class="form-control" placeholder="Enter code" value="@Model.Reservation.DiscountCode" />
                            <button type="button" class="btn btn-outline btn-sm" onclick="applyDiscount()">Apply</button>
                        </div>
                        <div id="discountMsg" style="font-size:12px; margin-top:4px; display:none;"></div>
                    </div>
                    <div style="border-top:1px solid var(--border); padding-top:12px;">
                        <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px;">
                            <span style="color:var(--text-muted);">Subtotal</span>
                            <span id="subtotalDisplay">₱0.00</span>
                        </div>
                        <div id="discountRow" style="display:none; display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px; color:var(--danger);">
                            <span>Discount</span>
                            <span id="discountDisplay">-₱0.00</span>
                        </div>
                        <div style="display:flex; justify-content:space-between; font-size:16px; font-weight:700; padding-top:8px; border-top:1px solid var(--border);">
                            <span>Total</span>
                            <span id="totalDisplay" style="color:var(--primary);">₱0.00</span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary" style="width:100%; margin-top:16px;">
                        <i class="bi bi-check-lg"></i> Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    var bookingItems = [];
    var activeDiscount = null;

    @foreach (var item in Model.Reservation.Items)
    {
        @:bookingItems.push({ itemtype: '@item.ItemType', referenceid: @item.ReferenceId, name: '@item.Name', unitprice: @item.UnitPrice, quantity: @item.Quantity });
    }

    function renderItems() {
        var tbody = document.getElementById('itemsBody');
        var html = '';
        var subtotal = 0;
        bookingItems.forEach(function(item, i) {
            var sub = item.unitprice * item.quantity;
            subtotal += sub;
            html += '<tr>' +
                '<td><strong>' + item.name + '</strong></td>' +
                '<td><span class="badge badge-info">' + item.itemtype + '</span></td>' +
                '<td>₱' + item.unitprice.toFixed(2) + '</td>' +
                '<td><input type="number" min="1" value="' + item.quantity + '" class="form-control" style="width:60px;" onchange="updateQty(' + i + ', this.value)"></td>' +
                '<td>₱' + sub.toFixed(2) + '</td>' +
                '<td><button type="button" class="btn-icon danger" onclick="removeItem(' + i + ')"><i class="bi bi-trash"></i></button></td>' +
                '</tr>';
        });
        if (bookingItems.length === 0) {
            html = '<tr><td colspan="6" style="text-align:center; padding:20px; color:var(--text-muted);">No items added</td></tr>';
        }
        tbody.innerHTML = html;
        updateTotal(subtotal);
    }

    function updateTotal(subtotal) {
        document.getElementById('subtotalDisplay').textContent = '₱' + subtotal.toFixed(2);
        var discount = 0;
        if (activeDiscount) {
            discount = activeDiscount.isPercent ? subtotal * (activeDiscount.value / 100) : activeDiscount.value;
            document.getElementById('discountRow').style.display = 'flex';
            document.getElementById('discountDisplay').textContent = '-₱' + discount.toFixed(2);
        } else {
            document.getElementById('discountRow').style.display = 'none';
        }
        document.getElementById('totalDisplay').textContent = '₱' + (subtotal - discount).toFixed(2);
    }

    function addRoom() {
        var sel = document.getElementById('addRoomSelect');
        if (!sel.value) return;
        var opt = sel.options[sel.selectedIndex];
        bookingItems.push({ itemtype: 'Room', referenceid: parseInt(sel.value), name: opt.dataset.name, unitprice: parseFloat(opt.dataset.price), quantity: 1 });
        sel.value = '';
        renderItems();
    }

    function addActivity() {
        var sel = document.getElementById('addActivitySelect');
        if (!sel.value) return;
        var opt = sel.options[sel.selectedIndex];
        bookingItems.push({ itemtype: 'Activity', referenceid: parseInt(sel.value), name: opt.dataset.name, unitprice: parseFloat(opt.dataset.price), quantity: 1 });
        sel.value = '';
        renderItems();
    }

    function updateQty(idx, val) {
        bookingItems[idx].quantity = parseInt(val) || 1;
        renderItems();
    }

    function removeItem(idx) {
        bookingItems.splice(idx, 1);
        renderItems();
    }

    function applyDiscount() {
        var code = document.getElementById('discountInput').value.trim();
        if (!code) return;
        var msg = document.getElementById('discountMsg');
        fetch('/Api/Discounts?code=' + encodeURIComponent(code))
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d.valid) {
                    activeDiscount = { code: code, isPercent: d.isPercent, value: d.value };
                    msg.style.display = 'block';
                    msg.style.color = 'var(--success)';
                    msg.textContent = '✓ ' + (d.isPercent ? d.value + '%' : '₱' + d.value) + ' discount applied';
                    document.getElementById('discountCodeHidden').value = code;
                    renderItems();
                } else {
                    activeDiscount = null;
                    msg.style.display = 'block';
                    msg.style.color = 'var(--danger)';
                    msg.textContent = 'Invalid or expired code';
                    document.getElementById('discountCodeHidden').value = '';
                    renderItems();
                }
            });
    }

    document.getElementById('editForm').addEventListener('submit', function() {
        document.getElementById('itemsJson').value = JSON.stringify(bookingItems);
    });

    renderItems();
</script>
}

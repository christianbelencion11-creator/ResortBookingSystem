@page
@model ResortBookingSystem.Pages.Reservations.IndexModel
@{ ViewData["Title"] = "Reservations"; }

<div class="filter-bar">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search by ID, guest name..." id="resSearch" oninput="filterRes(this.value)" />
    </div>
    <div class="filter-tabs">
        <button class="filter-tab active" onclick="filterByStatus(this, '')">All</button>
        <button class="filter-tab" onclick="filterByStatus(this, 'Pending')">Pending</button>
        <button class="filter-tab" onclick="filterByStatus(this, 'Confirmed')">Confirmed</button>
        <button class="filter-tab" onclick="filterByStatus(this, 'CheckedIn')">Checked-In</button>
        <button class="filter-tab" onclick="filterByStatus(this, 'CheckedOut')">Checked-Out</button>
    </div>
    <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Booking</a>
</div>

<div class="card">
    <div class="table-wrapper">
        <table class="table" id="resTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Guest</th>
                    <th>Check-In</th>
                    <th>Check-Out</th>
                    <th>Nights</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Reservations)
                {
                    <tr data-status="@r.Status" data-id="@r.ReservationId">
                        <td><strong>#@r.ReservationId</strong></td>
                        <td>@(r.Guest?.FullName ?? r.User?.FullName ?? "N/A")</td>
                        <td>@r.CheckInDate.ToString("MMM dd, yyyy")</td>
                        <td>@r.CheckOutDate.ToString("MMM dd, yyyy")</td>
                        <td>@r.NumberOfNights</td>
                        <td>@r.Items.Count</td>
                        <td><strong>₱@r.TotalAmount.ToString("N2")</strong></td>
                        <td><span class="status-badge status-@r.Status"><span class="status-dot"></span> @r.Status</span></td>
                        <td>
                            <div class="table-actions">
                                <a asp-page="Details" asp-route-id="@r.ReservationId" class="btn-icon" title="View"><i class="bi bi-eye"></i></a>
                                @if (r.Status != ReservationStatus.Cancelled && r.Status != ReservationStatus.CheckedIn && r.Status != ReservationStatus.CheckedOut)
                                {
                                    <a asp-page="Edit" asp-route-id="@r.ReservationId" class="btn-icon" title="Edit"><i class="bi bi-pencil"></i></a>
                                }
                                <a asp-page="/Receipt/Index" asp-route-id="@r.ReservationId" class="btn-icon" title="Receipt" target="_blank"><i class="bi bi-receipt"></i></a>
                                @if (r.Status != ReservationStatus.Cancelled && r.Status != ReservationStatus.CheckedOut)
                                {
                                    <button class="btn-icon danger" title="Cancel Reservation" onclick="confirmCancel(@r.ReservationId, '#@r.ReservationId')"><i class="bi bi-x-circle"></i></button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Cancel Reservation Modal -->
<div class="modal fade" id="cancelResModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <input type="hidden" id="cancelResId" />
            <div class="modal-header" style="background: rgba(231,76,60,0.1); border-bottom: 1px solid rgba(231,76,60,0.2);">
                <h5 class="modal-title" style="color: var(--danger);"><i class="bi bi-x-circle"></i> Cancel Reservation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to cancel reservation <strong id="cancelResNumber"></strong>?</p>
                <p class="text-muted" style="font-size: 13px;">This will set the reservation status to Cancelled.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-bs-dismiss="modal">No, keep it</button>
                <button type="button" class="btn btn-danger" onclick="doCancelRes()"><i class="bi bi-x-circle"></i> Cancel Reservation</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function filterRes(q) {
        document.querySelectorAll('#resTable tbody tr').forEach(r => {
            r.style.display = r.textContent.toLowerCase().includes(q.toLowerCase()) ? '' : 'none';
        });
    }
    function filterByStatus(btn, status) {
        document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('#resTable tbody tr').forEach(r => {
            r.style.display = (!status || r.dataset.status === status) ? '' : 'none';
        });
    }
    function confirmCancel(id, number) {
        document.getElementById('cancelResId').value = id;
        document.getElementById('cancelResNumber').textContent = number;
        new bootstrap.Modal(document.getElementById('cancelResModal')).show();
    }
    function doCancelRes() {
        var id = document.getElementById('cancelResId').value;
        fetch('/Api/CrudApi?handler=CancelReservation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + id
        }).then(function(r) { return r.json(); }).then(function(d) {
            bootstrap.Modal.getInstance(document.getElementById('cancelResModal')).hide();
            if (d.success) {
                var row = document.querySelector('#resTable tbody tr[data-id="' + id + '"]');
                if (row) {
                    var statusCell = row.querySelectorAll('td')[7];
                    statusCell.innerHTML = '<span class="status-badge status-Cancelled"><span class="status-dot"></span> Cancelled</span>';
                    var actions = row.querySelector('.table-actions');
                    if (actions) {
                        var cancelBtn = actions.querySelector('.btn-icon.danger');
                        if (cancelBtn) cancelBtn.remove();
                    }
                }
                showToast(d.message, 'success');
            }
        });
    }
</script>
}

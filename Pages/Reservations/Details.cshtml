@page "{id:int}"
@model ResortBookingSystem.Pages.Reservations.DetailsModel
@{ ViewData["Title"] = $"Reservation #{Model.Reservation.ReservationId}"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-receipt"></i> Reservation #@Model.Reservation.ReservationId</h2>
    <div>
        <a asp-page="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card p-4 mb-3">
            <div class="row">
                <div class="col-md-6">
                    <h6 class="text-muted">Guest</h6>
                    <p class="fw-bold">@(Model.Reservation.Guest?.FullName ?? Model.Reservation.User?.FullName ?? "N/A")</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted">Check-In</h6>
                    <p class="fw-bold">@Model.Reservation.CheckInDate.ToString("MMM dd, yyyy")</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted">Check-Out</h6>
                    <p class="fw-bold">@Model.Reservation.CheckOutDate.ToString("MMM dd, yyyy")</p>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-4">
                    <h6 class="text-muted">Status</h6>
                    <span class="badge badge-status @Model.Reservation.Status fs-6">@Model.Reservation.Status</span>
                </div>
                <div class="col-md-4">
                    <h6 class="text-muted">Duration</h6>
                    <p>@Model.Reservation.NumberOfNights night(s)</p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-muted">Special Requests</h6>
                    <p>@(Model.Reservation.SpecialRequests ?? "None")</p>
                </div>
            </div>
        </div>

        <div class="card p-4">
            <h5>Booking Items</h5>
            <table class="table">
                <thead><tr><th>Type</th><th>Description</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.Reservation.Items)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@item.ItemType</span></td>
                            <td>@item.ReferenceId</td>
                            <td>@item.Quantity</td>
                            <td>₱@item.UnitPrice.ToString("N2")</td>
                            <td class="fw-bold">₱@item.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-success">
                        <td colspan="4" class="text-end fw-bold">Total</td>
                        <td class="fw-bold">₱@Model.Reservation.TotalAmount.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-4 mb-3">
            <h5>Payment Summary</h5>
            <div class="d-flex justify-content-between mb-2">
                <span>Total Amount:</span>
                <span class="fw-bold">₱@Model.Reservation.TotalAmount.ToString("N2")</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span>Total Paid:</span>
                <span class="text-success fw-bold">₱@Model.Reservation.TotalPaid.ToString("N2")</span>
            </div>
            <hr />
            <div class="d-flex justify-content-between mb-3">
                <span>Balance:</span>
                <span class="text-danger fw-bold fs-5">₱@Model.Reservation.Balance.ToString("N2")</span>
            </div>
        </div>

        <div class="card p-4 mb-3">
            <h5>Update Status</h5>
            <form method="post" asp-page-handler="UpdateStatus">
                <input type="hidden" name="id" value="@Model.Reservation.ReservationId" />
                <select name="newStatus" class="form-select mb-2">
                    <option value="Pending">Pending</option>
                    <option value="Confirmed">Confirmed</option>
                    <option value="CheckedIn">Checked-In</option>
                    <option value="CheckedOut">Checked-Out</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
                <button type="submit" class="btn btn-resort w-100"><i class="bi bi-check-lg"></i> Update</button>
            </form>
        </div>

        <div class="card p-4">
            <h5>Payments</h5>
            @foreach (var p in Model.Reservation.Payments)
            {
                <div class="d-flex justify-content-between mb-1">
                    <span>@p.PaymentMethod - @p.PaymentType</span>
                    <span class="text-success">₱@p.Amount.ToString("N2")</span>
                </div>
            }
            <a asp-page="/Payments/Index" asp-route-reservationId="@Model.Reservation.ReservationId" class="btn btn-outline-success w-100 mt-2">
                <i class="bi bi-credit-card"></i> Record Payment
            </a>
        </div>
    </div>
</div>

@page
@model ResortBookingSystem.Pages.Payments.IndexModel
@{ ViewData["Title"] = "Payments"; }

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px;">
    <div class="card">
        <div class="card-header">
            <h5><i class="bi bi-credit-card"></i> Payment History</h5>
        </div>
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr><th>ID</th><th>Reservation</th><th>Guest</th><th>Amount</th><th>Method</th><th>Type</th><th>Date</th><th>Status</th><th>Receipt</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Payments)
                    {
                        var guestName = p.Reservation?.Guest?.FullName ?? p.Reservation?.User?.FullName ?? "N/A";
                        <tr>
                            <td><strong>#@p.PaymentId</strong></td>
                            <td><a asp-page="/Reservations/Details" asp-route-id="@p.ReservationId" class="text-decoration-none fw-semibold">#@p.ReservationId</a></td>
                            <td>@guestName</td>
                            <td><strong style="color: var(--success);">₱@p.Amount.ToString("N2")</strong></td>
                            <td><span class="badge badge-info">@p.PaymentMethod</span></td>
                            <td>@p.PaymentType</td>
                            <td>@p.PaymentDate.ToString("MMM dd, HH:mm")</td>
                            <td><span class="status-badge status-@p.Status"><span class="status-dot"></span> @p.Status</span></td>
                            <td>
                                <a asp-page="/Receipt/Index" asp-route-id="@p.ReservationId" target="_blank" class="btn btn-sm btn-outline-secondary py-0 px-2" title="View Receipt">
                                    <i class="bi bi-receipt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5><i class="bi bi-plus-circle"></i> Record Payment</h5></div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Reservation ID</label>
                    <input asp-for="Input.ReservationId" type="number" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Amount (₱)</label>
                    <input asp-for="Input.Amount" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Method</label>
                    <select asp-for="Input.PaymentMethod" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Type</label>
                    <select asp-for="Input.PaymentType" asp-items="Html.GetEnumSelectList<PaymentType>()" class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Reference #</label>
                    <input asp-for="Input.ReferenceNumber" class="form-control" placeholder="Optional" />
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;"><i class="bi bi-check-lg"></i> Record Payment</button>
            </form>
        </div>
    </div>
</div>

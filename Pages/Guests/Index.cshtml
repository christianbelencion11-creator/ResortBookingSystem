@page
@model ResortBookingSystem.Pages.Guests.IndexModel
@{ ViewData["Title"] = "Guest Management"; }

<div class="filter-bar">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search guests by name, email, phone..." id="guestSearch" oninput="filterGuests(this.value)" />
    </div>
</div>

<div class="stats-grid" style="margin-bottom:16px;">
    <div class="stat-card">
        <div class="stat-header"><div class="stat-icon blue"><i class="bi bi-people"></i></div></div>
        <div class="stat-number">@Model.Guests.Count</div>
        <div class="stat-label">Total Guests</div>
    </div>
    <div class="stat-card">
        <div class="stat-header"><div class="stat-icon green"><i class="bi bi-arrow-repeat"></i></div></div>
        <div class="stat-number">@Model.Guests.Count(g => g.TotalBookings > 1)</div>
        <div class="stat-label">Returning Guests</div>
    </div>
    <div class="stat-card">
        <div class="stat-header"><div class="stat-icon orange"><i class="bi bi-cash-stack"></i></div></div>
        <div class="stat-number">₱@Model.Guests.Sum(g => g.TotalSpent).ToString("N0")</div>
        <div class="stat-label">Total Revenue</div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5><i class="bi bi-people"></i> Guest Directory</h5>
    </div>
    <div class="table-wrapper">
        <table class="table" id="guestsTable">
            <thead>
                <tr>
                    <th>Guest</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>ID Type</th>
                    <th>Total Bookings</th>
                    <th>Total Spent</th>
                    <th>Last Visit</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model.Guests)
                {
                    <tr>
                        <td><strong>@g.FullName</strong></td>
                        <td>@(g.Email ?? "-")</td>
                        <td>@(g.PhoneNumber ?? "-")</td>
                        <td>@(g.IdType ?? "-")</td>
                        <td><span class="badge badge-info">@g.TotalBookings</span></td>
                        <td><strong>₱@g.TotalSpent.ToString("N2")</strong></td>
                        <td>@g.LastVisit.ToString("MMM dd, yyyy")</td>
                        <td>
                            <div class="table-actions">
                                <a asp-page="Details" asp-route-id="@g.GuestId" class="btn-icon" title="View Details"><i class="bi bi-eye"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    function filterGuests(q) {
        document.querySelectorAll('#guestsTable tbody tr').forEach(r => {
            r.style.display = r.textContent.toLowerCase().includes(q.toLowerCase()) ? '' : 'none';
        });
    }
</script>
}

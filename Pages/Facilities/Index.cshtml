@page
@model ResortBookingSystem.Pages.Facilities.IndexModel
@{ ViewData["Title"] = "Facilities"; }

<div class="filter-bar">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search facilities..." id="facilitySearch" oninput="filterFacilities(this.value)" />
    </div>
    <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Facility</a>
</div>

<div class="card">
    <div class="table-wrapper">
        <table class="table" id="facTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Rental Price</th>
                    <th>Capacity</th>
                    <th>Available Slots</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var facility in Model.Facilities)
                {
                    <tr data-id="@facility.FacilityId">
                        <td><strong>#@facility.FacilityId</strong></td>
                        <td><strong>@facility.FacilityName</strong></td>
                        <td style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@(facility.Description ?? "-")</td>
                        <td><strong>₱@facility.RentalPrice.ToString("N0")</strong>/rental</td>
                        <td>@facility.Capacity pax</td>
                        <td>@facility.Schedules.Count(s => s.Status == FacilityScheduleStatus.Available) slots</td>
                        <td><span class="badge @(facility.IsActive ? "badge-success" : "badge-danger")">@(facility.IsActive ? "Active" : "Inactive")</span></td>
                        <td>
                            <div class="table-actions">
                                <a asp-page="Book" asp-route-id="@facility.FacilityId" class="btn-icon" title="Book" style="color:var(--success);"><i class="bi bi-calendar-plus"></i></a>
                                <a asp-page="Edit" asp-route-id="@facility.FacilityId" class="btn-icon" title="Edit"><i class="bi bi-pencil"></i></a>
                                <button class="btn-icon danger" title="Delete" onclick="confirmDelete(@facility.FacilityId, '@facility.FacilityName')"><i class="bi bi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Facility Modal -->
<div class="modal fade" id="deleteFacilityModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <input type="hidden" id="deleteFacilityId" />
            <div class="modal-header" style="background: rgba(231,76,60,0.1); border-bottom: 1px solid rgba(231,76,60,0.2);">
                <h5 class="modal-title" style="color: var(--danger);"><i class="bi bi-trash"></i> Delete Facility</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="deleteFacilityName"></strong>?</p>
                <p class="text-muted" style="font-size: 13px;">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="doDeleteFacility()"><i class="bi bi-trash"></i> Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function filterFacilities(q) {
        document.querySelectorAll('#facTable tbody tr').forEach(r => {
            r.style.display = r.textContent.toLowerCase().includes(q.toLowerCase()) ? '' : 'none';
        });
    }
    function confirmDelete(id, name) {
        document.getElementById('deleteFacilityId').value = id;
        document.getElementById('deleteFacilityName').textContent = name;
        new bootstrap.Modal(document.getElementById('deleteFacilityModal')).show();
    }
    function doDeleteFacility() {
        var id = document.getElementById('deleteFacilityId').value;
        fetch('/Api/CrudApi?handler=DeleteFacility', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + id
        }).then(function(r) { return r.json(); }).then(function(d) {
            bootstrap.Modal.getInstance(document.getElementById('deleteFacilityModal')).hide();
            if (d.success) {
                var row = document.querySelector('#facTable tbody tr[data-id="' + id + '"]');
                if (row) { row.style.transition = 'opacity 0.3s'; row.style.opacity = '0'; setTimeout(function() { row.remove(); }, 300); }
                showToast(d.message, 'success');
            }
        });
    }
</script>
}

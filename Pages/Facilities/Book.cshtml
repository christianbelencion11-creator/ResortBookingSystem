@page "{id:int}"
@model ResortBookingSystem.Pages.Facilities.BookModel
@{ ViewData["Title"] = $"Book {Model.Facility.FacilityName}"; }

<div class="page-header">
    <h2><i class="bi bi-calendar-plus"></i> Book @Model.Facility.FacilityName</h2>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card p-4">
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Facility:</strong> @Model.Facility.FacilityName
                </div>
                <div class="col-md-6">
                    <strong>Price:</strong> ₱@Model.Facility.RentalPrice.ToString("N2")/rental
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Capacity:</strong> @Model.Facility.Capacity persons
                </div>
                <div class="col-md-6">
                    <strong>Description:</strong> @(Model.Facility.Description ?? "N/A")
                </div>
            </div>

            <form method="post" class="mt-4">
                <input type="hidden" asp-for="Facility.FacilityId" />
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Date</label>
                        <input asp-for="BookDate" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Start Time</label>
                        <input asp-for="StartTime" type="time" class="form-control" value="08:00" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">End Time</label>
                        <input asp-for="EndTime" type="time" class="form-control" value="17:00" />
                    </div>
                </div>

                <h5 class="mt-4 mb-3">Available Time Slots for @Model.BookDate.ToString("MMM dd, yyyy")</h5>
                @if (Model.AvailableSchedules.Any())
                {
                    <div class="row g-2">
                        @foreach (var schedule in Model.AvailableSchedules)
                        {
                            <div class="col-md-3">
                                <div class="card p-2 text-center" style="cursor:pointer"
                                     onclick="selectSlot('@schedule.StartTime', '@schedule.EndTime')">
                                    <small class="fw-bold">@schedule.StartTime.ToString(@"hh\:mm") - @schedule.EndTime.ToString(@"hh\:mm")</small>
                                    <span class="badge bg-success">Available</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No slots available for this date. Try another date.</p>
                }

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-resort"><i class="bi bi-check-lg"></i> Book Facility</button>
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function selectSlot(start, end) {
        document.getElementById('StartTime').value = start.substring(0, 5);
        document.getElementById('EndTime').value = end.substring(0, 5);
    }
</script>
}

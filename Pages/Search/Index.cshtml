@page
@model ResortBookingSystem.Pages.Search.IndexModel
@{ ViewData["Title"] = "Search"; }

<div class="card mb-4">
    <div class="card-body" style="padding: 20px;">
        <form method="get">
            <div class="search-form-row">
                <div class="search-form-group search-form-type">
                    <label class="form-label">Type</label>
                    <select asp-for="Query.Type" class="form-select">
                        <option value="all">All</option>
                        <option value="reservations">Reservations</option>
                        <option value="rooms">Rooms</option>
                        <option value="guests">Guests</option>
                        <option value="activities">Activities</option>
                    </select>
                </div>
                <div class="search-form-group search-form-keyword">
                    <label class="form-label">Keyword</label>
                    <div style="position:relative;">
                        <i class="bi bi-search" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--text-muted); font-size:14px;"></i>
                        <input asp-for="Query.Keyword" class="form-control" placeholder="Search by name, email, ID..." style="padding-left: 36px;" />
                    </div>
                </div>
                <div class="search-form-group search-form-date">
                    <label class="form-label">From</label>
                    <input asp-for="Query.FromDate" type="date" class="form-control" />
                </div>
                <div class="search-form-group search-form-date">
                    <label class="form-label">To</label>
                    <input asp-for="Query.ToDate" type="date" class="form-control" />
                </div>
                <div class="search-form-group search-form-btn">
                    <button type="submit" class="btn btn-primary" style="height: 38px; padding: 0 20px;">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Query.Keyword != null)
{
    <div class="mb-3" style="display: flex; align-items: center; gap: 8px;">
        <span style="font-size: 14px; color: var(--text-secondary);">
            Found <strong style="color: var(--text-primary);">@Model.TotalResults</strong> results for "<strong style="color: var(--primary);">@Model.Query.Keyword</strong>"
        </span>
    </div>
}

<!-- Reservations Results -->
@if (Model.ReservationResults.Any())
{
    <div class="card mb-4">
        <div class="card-header" style="background: rgba(67,185,127,0.08); border-bottom: 1px solid rgba(67,185,127,0.2);">
            <h5 style="margin:0; font-size: 15px; font-weight: 600; color: var(--success);"><i class="bi bi-calendar-check"></i> Reservations</h5>
            <span class="badge badge-success">@Model.ReservationResults.Count found</span>
        </div>
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Guest</th>
                        <th>Check-In</th>
                        <th>Check-Out</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.ReservationResults)
                    {
                        <tr>
                            <td><strong>#@r.ReservationId</strong></td>
                            <td>@(r.Guest?.FullName ?? r.User?.FullName ?? "N/A")</td>
                            <td>@r.CheckInDate.ToString("MMM dd, yyyy")</td>
                            <td>@r.CheckOutDate.ToString("MMM dd, yyyy")</td>
                            <td><strong>₱@r.TotalAmount.ToString("N2")</strong></td>
                            <td><span class="status-badge status-@r.Status"><span class="status-dot"></span> @r.Status</span></td>
                            <td>
                                <div class="table-actions">
                                    <a asp-page="/Reservations/Details" asp-route-id="@r.ReservationId" class="btn-icon" title="View"><i class="bi bi-eye"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Rooms Results -->
@if (Model.RoomResults.Any())
{
    <div class="card mb-4">
        <div class="card-header" style="background: rgba(52,152,219,0.08); border-bottom: 1px solid rgba(52,152,219,0.2);">
            <h5 style="margin:0; font-size: 15px; font-weight: 600; color: var(--info);"><i class="bi bi-door-open"></i> Rooms</h5>
            <span class="badge badge-info">@Model.RoomResults.Count found</span>
        </div>
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>Room #</th>
                        <th>Type</th>
                        <th>Floor</th>
                        <th>Price/Night</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.RoomResults)
                    {
                        <tr>
                            <td><strong>@r.RoomNumber</strong></td>
                            <td>@r.RoomType.TypeName</td>
                            <td>@(r.Floor?.ToString() ?? "-")</td>
                            <td><strong>₱@r.RoomType.BasePrice.ToString("N2")</strong></td>
                            <td><span class="status-badge status-@r.Status"><span class="status-dot"></span> @r.Status</span></td>
                            <td>
                                <div class="table-actions">
                                    <a asp-page="/Rooms/Edit" asp-route-id="@r.RoomId" class="btn-icon" title="Edit"><i class="bi bi-pencil"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Guest Results -->
@if (Model.GuestResults.Any())
{
    <div class="card mb-4">
        <div class="card-header" style="background: rgba(155,89,182,0.08); border-bottom: 1px solid rgba(155,89,182,0.2);">
            <h5 style="margin:0; font-size: 15px; font-weight: 600; color: #9b59b6;"><i class="bi bi-person"></i> Guests</h5>
            <span class="badge" style="background:rgba(155,89,182,0.1); color:#9b59b6;">@Model.GuestResults.Count found</span>
        </div>
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>ID Type</th>
                        <th>Joined</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model.GuestResults)
                    {
                        <tr>
                            <td><strong>#@g.GuestId</strong></td>
                            <td><strong>@g.FullName</strong></td>
                            <td>@(g.Email ?? "N/A")</td>
                            <td>@(g.PhoneNumber ?? "N/A")</td>
                            <td>@(g.IdType ?? "N/A")</td>
                            <td>@g.CreatedAt.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Activity Results -->
@if (Model.ActivityResults.Any())
{
    <div class="card mb-4">
        <div class="card-header" style="background: rgba(245,166,35,0.08); border-bottom: 1px solid rgba(245,166,35,0.2);">
            <h5 style="margin:0; font-size: 15px; font-weight: 600; color: var(--warning);"><i class="bi bi-compass"></i> Activities</h5>
            <span class="badge badge-warning">@Model.ActivityResults.Count found</span>
        </div>
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Price/Hour</th>
                        <th>Price/Day</th>
                        <th>Max PAX</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.ActivityResults)
                    {
                        <tr>
                            <td><strong>#@a.ActivityId</strong></td>
                            <td><strong>@a.ActivityName</strong></td>
                            <td>@(a.PricePerHour?.ToString("N2") ?? "N/A")</td>
                            <td>@(a.PricePerDay?.ToString("N2") ?? "N/A")</td>
                            <td>@a.MaxParticipants pax</td>
                            <td><span class="badge @(a.IsActive ? "badge-success" : "badge-danger")">@(a.IsActive ? "Active" : "Inactive")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Empty state -->
@if (!Model.ReservationResults.Any() && !Model.RoomResults.Any() && !Model.GuestResults.Any() && !Model.ActivityResults.Any() && Model.Query.Keyword != null)
{
    <div class="empty-state">
        <i class="bi bi-search"></i>
        <p>No results found for "<strong>@Model.Query.Keyword</strong>"</p>
    </div>
}

<!-- Initial state -->
@if (Model.Query.Keyword == null)
{
    <div class="empty-state">
        <i class="bi bi-search"></i>
        <p>Enter a keyword above to start searching</p>
    </div>
}

<style>
    .search-form-row {
        display: flex;
        gap: 12px;
        align-items: flex-end;
    }
    .search-form-group {
        display: flex;
        flex-direction: column;
    }
    .search-form-type { width: 140px; flex-shrink: 0; }
    .search-form-keyword { flex: 1; min-width: 200px; }
    .search-form-date { width: 150px; flex-shrink: 0; }
    .search-form-btn { flex-shrink: 0; }
    .search-form-group .form-select,
    .search-form-group .form-control {
        height: 38px;
    }
</style>

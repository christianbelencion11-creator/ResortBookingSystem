@page
@model ResortBookingSystem.Pages.Settings.IndexModel
@{ ViewData["Title"] = "Settings"; }

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
    <!-- Brand / Logo -->
    <div class="card">
        <div class="card-header"><h5><i class="bi bi-palette"></i> Brand & Logo</h5></div>
        <div class="card-body">
            <form method="post" asp-page-handler="SaveBrand" enctype="multipart/form-data">
                <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 16px;">
                    <div id="logoPreview" style="width:64px; height:64px; border-radius:12px; background:var(--primary); display:flex; align-items:center; justify-content:center; color:#fff; font-size:28px; flex-shrink:0; overflow:hidden; border:2px solid var(--border);">
                        @if (!string.IsNullOrEmpty(Model.LogoImage))
                        {
                            <img src="@Model.LogoImage" style="width:100%; height:100%; object-fit:cover;" alt="Logo" />
                        }
                        else
                        {
                            <i class="bi bi-water"></i>
                        }
                    </div>
                    <div>
                        <label class="form-label">Logo Image</label>
                        <input type="file" asp-for="LogoFile" class="form-control" accept="image/*" style="font-size:12px;" onchange="previewLogo(this)" />
                        <div style="font-size:11px; color:var(--text-muted); margin-top:4px;">Recommended: 128x128px, PNG/JPG</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Sidebar Name</label>
                    <input asp-for="BrandName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Subtitle</label>
                    <input asp-for="BrandSubtitle" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Brand</button>
            </form>
        </div>
    </div>

    <!-- Resort Info -->
    <div class="card">
        <div class="card-header"><h5><i class="bi bi-building"></i> Resort Information</h5></div>
        <div class="card-body">
            <form method="post" asp-page-handler="SaveResort">
                <div class="mb-3">
                    <label class="form-label">Resort Name</label>
                    <input asp-for="ResortName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Address</label>
                    <textarea asp-for="ResortAddress" class="form-control" rows="2"></textarea>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone</label>
                        <input asp-for="ResortPhone" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        <input asp-for="ResortEmail" class="form-control" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
            </form>
        </div>
    </div>

    <!-- Booking Rules -->
    <div class="card">
        <div class="card-header"><h5><i class="bi bi-sliders"></i> Booking Rules</h5></div>
        <div class="card-body">
            <form method="post" asp-page-handler="SaveRules">
                <div class="mb-3">
                    <label class="form-label">Check-In Time</label>
                    <input asp-for="CheckInTime" type="time" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Check-Out Time</label>
                    <input asp-for="CheckOutTime" type="time" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Downpayment Percentage (%)</label>
                    <input asp-for="DownpaymentPercent" type="number" min="0" max="100" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Max Advance Booking (days)</label>
                    <input asp-for="MaxAdvanceDays" type="number" class="form-control" />
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="AllowWalkIn" class="form-check-input" />
                    <label class="form-check-label">Allow Walk-In Bookings</label>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
            </form>
        </div>
    </div>

    <!-- Tax & Pricing -->
    <div class="card">
        <div class="card-header"><h5><i class="bi bi-percent"></i> Tax & Pricing</h5></div>
        <div class="card-body">
            <form method="post" asp-page-handler="SavePricing">
                <div class="mb-3">
                    <label class="form-label">VAT Rate (%)</label>
                    <input asp-for="VatRate" type="number" step="0.01" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Service Charge (%)</label>
                    <input asp-for="ServiceCharge" type="number" step="0.01" class="form-control" />
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="IncludeTaxInPrice" class="form-check-input" />
                    <label class="form-check-label">Display prices inclusive of tax</label>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
            </form>
        </div>
    </div>
</div>

<!-- System Info -->
<div class="card" style="margin-top: 20px;">
    <div class="card-header"><h5><i class="bi bi-info-circle"></i> System Information</h5></div>
    <div class="card-body" style="padding: 16px 20px;">
        <div style="display: flex; gap: 32px; flex-wrap: wrap;">
            <div style="display: flex; gap: 8px; font-size: 13px;">
                <span style="color: var(--text-muted);">Version</span><strong>1.0.0</strong>
            </div>
            <div style="display: flex; gap: 8px; font-size: 13px;">
                <span style="color: var(--text-muted);">Framework</span><strong>ASP.NET Core 8.0</strong>
            </div>
            <div style="display: flex; gap: 8px; font-size: 13px;">
                <span style="color: var(--text-muted);">Database</span><strong>MySQL 8.0</strong>
            </div>
            <div style="display: flex; gap: 8px; font-size: 13px;">
                <span style="color: var(--text-muted);">Last Backup</span><strong>@DateTime.Now.ToString("MMM dd, yyyy")</strong>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function previewLogo(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                var preview = document.getElementById('logoPreview');
                preview.innerHTML = '<img src="' + e.target.result + '" style="width:100%; height:100%; object-fit:cover;" alt="Logo" />';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
}

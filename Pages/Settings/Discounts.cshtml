@page
@model ResortBookingSystem.Pages.Settings.DiscountsModel
@{ ViewData["Title"] = "Discount Codes"; }

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a asp-page="Index" class="btn-icon" title="Back to Settings"><i class="bi bi-arrow-left"></i></a>
    <h5 style="margin:0;">Discount Codes</h5>
</div>

<div style="display:grid; grid-template-columns:1fr 1.5fr; gap:20px;">
    <!-- Add New Code -->
    <div class="card">
        <div class="card-header"><h5><i class="bi bi-plus-circle"></i> Create Discount Code</h5></div>
        <div class="card-body">
            <form method="post" asp-page-handler="Add">
                <div class="mb-3">
                    <label class="form-label">Code</label>
                    <input asp-for="NewCode.Code" class="form-control" placeholder="e.g. SUMMER25" required style="text-transform:uppercase;" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <input asp-for="NewCode.Description" class="form-control" placeholder="e.g. Summer promo discount" required />
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="NewCode.IsPercent" class="form-check-input" checked />
                    <label class="form-check-label">Percentage discount (uncheck for fixed amount)</label>
                </div>
                <div class="mb-3">
                    <label class="form-label">Discount Value</label>
                    <input asp-for="NewCode.DiscountValue" type="number" step="0.01" min="0.01" class="form-control" required />
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                    <div class="mb-3">
                        <label class="form-label">Valid From</label>
                        <input asp-for="NewCode.ValidFrom" type="date" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Valid To</label>
                        <input asp-for="NewCode.ValidTo" type="date" class="form-control" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Max Uses (0 = unlimited)</label>
                    <input asp-for="NewCode.MaxUses" type="number" min="0" class="form-control" value="100" />
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="NewCode.IsActive" class="form-check-input" checked />
                    <label class="form-check-label">Active</label>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Create Code</button>
            </form>
        </div>
    </div>

    <!-- Existing Codes -->
    <div class="card">
        <div class="card-header"><h5><i class="bi bi-tag"></i> Discount Codes</h5></div>
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Discount</th>
                        <th>Validity</th>
                        <th>Usage</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Codes)
                    {
                        <tr>
                            <td><strong>@c.Code</strong><br/><span style="font-size:11px; color:var(--text-muted);">@c.Description</span></td>
                            <td><span class="badge badge-success">@(c.IsPercent ? c.DiscountValue + "%" : "₱" + c.DiscountValue)</span></td>
                            <td style="font-size:12px;">@c.ValidFrom.ToString("MMM dd") - @c.ValidTo.ToString("MMM dd, yyyy")</td>
                            <td>@c.CurrentUses / @(c.MaxUses == 0 ? "∞" : c.MaxUses.ToString())</td>
                            <td><span class="status-badge status-@(c.IsActive ? "Available" : "Cancelled")"><span class="status-dot"></span> @(c.IsActive ? "Active" : "Inactive")</span></td>
                            <td>
                                <div class="table-actions">
                                    <button type="button" class="btn-icon" title="Toggle" onclick="toggleDiscount(@c.DiscountCodeId, this)"><i class="bi bi-toggle-@(c.IsActive ? "on" : "off")"></i></button>
                                    <button type="button" class="btn-icon danger" title="Delete" onclick="deleteDiscount(@c.DiscountCodeId, this)"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleDiscount(id, btn) {
        fetch('/Api/DiscountCodesApi?handler=Toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + id
        }).then(function(r) { return r.json(); }).then(function(d) {
            if (d.success) {
                var row = btn.closest('tr');
                var statusCell = row.querySelectorAll('td')[4];
                var icon = btn.querySelector('i');
                if (d.isActive) {
                    statusCell.innerHTML = '<span class="status-badge status-Available"><span class="status-dot"></span> Active</span>';
                    icon.className = 'bi bi-toggle-on';
                } else {
                    statusCell.innerHTML = '<span class="status-badge status-Cancelled"><span class="status-dot"></span> Inactive</span>';
                    icon.className = 'bi bi-toggle-off';
                }
                showToast('Status updated', 'success');
            }
        });
    }
    function deleteDiscount(id, btn) {
        if (!confirm('Delete this discount code?')) return;
        fetch('/Api/DiscountCodesApi?handler=Delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + id
        }).then(function(r) { return r.json(); }).then(function(d) {
            if (d.success) {
                btn.closest('tr').remove();
                showToast('Discount code deleted', 'success');
            }
        });
    }
</script>
}

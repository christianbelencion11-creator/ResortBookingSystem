@page
@model ResortBookingSystem.Pages.Settings.PricingModel
@{ ViewData["Title"] = "Seasonal Pricing"; }

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a asp-page="Index" class="btn-icon" title="Back to Settings"><i class="bi bi-arrow-left"></i></a>
    <h5 style="margin:0;">Seasonal Pricing</h5>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
    <!-- Add New Rate -->
    <div class="card">
        <div class="card-header"><h5><i class="bi bi-plus-circle"></i> Add Seasonal Rate</h5></div>
        <div class="card-body">
            <form method="post" asp-page-handler="Add">
                <div class="mb-3">
                    <label class="form-label">Season Name</label>
                    <input asp-for="NewRate.SeasonName" class="form-control" placeholder="e.g. Peak Season, Holiday" required />
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                    <div class="mb-3">
                        <label class="form-label">Start Date</label>
                        <input asp-for="NewRate.StartDate" type="date" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">End Date</label>
                        <input asp-for="NewRate.EndDate" type="date" class="form-control" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Price Multiplier (e.g. 1.25 = +25%)</label>
                    <input asp-for="NewRate.PriceMultiplier" type="number" step="0.01" min="0.01" class="form-control" value="1.00" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Room Type (optional - leave empty for all)</label>
                    <select asp-for="NewRate.RoomTypeId" class="form-select">
                        <option value="">All Room Types</option>
                        @foreach (var rt in Model.RoomTypes)
                        {
                            <option value="@rt.RoomTypeId">@rt.TypeName</option>
                        }
                    </select>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="NewRate.IsActive" class="form-check-input" checked />
                    <label class="form-check-label">Active</label>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Rate</button>
            </form>
        </div>
    </div>

    <!-- Existing Rates -->
    <div class="card">
        <div class="card-header"><h5><i class="bi bi-list"></i> Seasonal Rates</h5></div>
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>Season</th>
                        <th>Period</th>
                        <th>Multiplier</th>
                        <th>Room Type</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rates)
                    {
                        <tr>
                            <td><strong>@r.SeasonName</strong></td>
                            <td style="font-size:12px;">@r.StartDate.ToString("MMM dd") - @r.EndDate.ToString("MMM dd, yyyy")</td>
                            <td><span class="badge badge-@(r.PriceMultiplier > 1 ? "warning" : "success")">×@r.PriceMultiplier.ToString("F2")</span></td>
                            <td>@r.RoomTypeName</td>
                            <td><span class="status-badge status-@(r.IsActive ? "Available" : "Cancelled")"><span class="status-dot"></span> @(r.IsActive ? "Active" : "Inactive")</span></td>
                            <td>
                                <div class="table-actions">
                                    <button type="button" class="btn-icon" title="Toggle" onclick="toggleRate(@r.SeasonalRateId, this)"><i class="bi bi-toggle-@(r.IsActive ? "on" : "off")"></i></button>
                                    <button type="button" class="btn-icon danger" title="Delete" onclick="deleteRate(@r.SeasonalRateId, this)"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleRate(id, btn) {
        fetch('/Api/SeasonalRatesApi?handler=Toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + id
        }).then(function(r) { return r.json(); }).then(function(d) {
            if (d.success) {
                var row = btn.closest('tr');
                var statusCell = row.querySelectorAll('td')[4];
                var icon = btn.querySelector('i');
                if (d.isActive) {
                    statusCell.innerHTML = '<span class="status-badge status-Available"><span class="status-dot"></span> Active</span>';
                    icon.className = 'bi bi-toggle-on';
                } else {
                    statusCell.innerHTML = '<span class="status-badge status-Cancelled"><span class="status-dot"></span> Inactive</span>';
                    icon.className = 'bi bi-toggle-off';
                }
                showToast('Status updated', 'success');
            }
        });
    }
    function deleteRate(id, btn) {
        if (!confirm('Delete this seasonal rate?')) return;
        fetch('/Api/SeasonalRatesApi?handler=Delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + id
        }).then(function(r) { return r.json(); }).then(function(d) {
            if (d.success) {
                btn.closest('tr').remove();
                showToast('Rate deleted', 'success');
            }
        });
    }
</script>
}

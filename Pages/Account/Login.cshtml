@page
@model ResortBookingSystem.Pages.Account.LoginModel
@{ ViewData["Title"] = "Login"; Layout = "_Layout"; }

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow p-4">
            <div class="text-center mb-3">
                <i class="bi bi-water text-success" style="font-size:3rem"></i>
                <h3 class="mt-2">Resort Booking</h3>
                <p class="text-muted">Sign in to continue</p>
            </div>
            <form method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Input.Email" class="form-control" placeholder="admin@resort.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input asp-for="Input.Password" type="password" class="form-control" placeholder="Password" />
                </div>
                <button type="submit" class="btn btn-resort w-100">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                </button>
            </form>
            <div class="text-center mt-3">
                <a asp-page="Register" class="text-decoration-none">Create an account</a>
            </div>
        </div>
    </div>
</div>
